# Copy to .env and adjust. .env is git-ignored; keep it that way (it holds the DB password).

# Host port the container is published on (localhost only).
MPCT_PORT=8010

# Postgres connection. On the home server the database runs in the "postgres" container on the
# shared Docker network; scripts/create_database.sql creates the user and database and shows
# how to add this line.
# DATABASE_URL=postgresql+psycopg://mpct:CHANGE_ME@postgres:5432/mpct

# "live" (default) for the real app. The test instance sets MPCT_ENV=test in docker-compose.test.yml,
# which marks every page with an orange top bar and a TEST badge. See "Test environment" in the README.
# MPCT_ENV=live

# Repertoire gap finder (Dashboard): the Lichess opening explorer needs a personal API token.
# Create one (free, no scopes ticked) at https://lichess.org/account/oauth/token and paste it here.
# LICHESS_TOKEN=lip_...
